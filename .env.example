# MultiAnno local configuration
#
# Copy this file to .env. Windows paths may use either / or \\.
# Values beginning with VITE_ are visible to the local frontend bundle, so do
# not put API keys or other secrets in them.

# Vision AI defaults shown in Settings > AI.
VITE_AI_MODEL_TYPE=SAM-3
VITE_AI_MODEL_PATH=
VITE_AI_CLASSES_PATH=

# Optional backend-only overrides. Leave these empty when the VITE_AI_* values
# above are sufficient. These are useful when calling the backend directly.
MULTIANNO_AI_MODEL_TYPE=
MULTIANNO_AI_MODEL_PATH=
MULTIANNO_AI_CLASSES_PATH=
MULTIANNO_AI_DEVICE=

# ONNX ReID model used by Track ID Annotation.
REID_MODEL_PATH=
# Optional: imagenet (default), none, or minus_one_one.
REID_NORMALIZATION=imagenet
# Optional ONNX Runtime provider, for example CUDAExecutionProvider.
REID_EXECUTION_PROVIDER=
# Optional Windows DLL directory containing CUDA/cuDNN runtime DLLs.
REID_CUDA_DLL_PATH=

# VLM/OpenAI-compatible endpoint. Keep the API key backend-only.
# These two optional VITE_ values only control the initial frontend display;
# the backend values below are authoritative for inference.
VITE_VLM_BASE_URL=
VITE_VLM_MODEL=
MULTIANNO_VLM_BASE_URL=https://api.openai.com/v1
MULTIANNO_VLM_MODEL=gpt-4o-mini
MULTIANNO_VLM_API_KEY=
# OPENAI_API_KEY may also be used as a fallback.
MULTIANNO_VLM_TIMEOUT=90
MULTIANNO_VLM_TEMPERATURE=0.1
MULTIANNO_VLM_MAX_TOKENS=1024

# Optional backend logging configuration.
MULTIANNO_LOG_LEVEL=INFO
MULTIANNO_LOG_FILE=
